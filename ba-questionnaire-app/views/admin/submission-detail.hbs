{{!-- views/admin/submission-detail.hbs --}}
{{!-- Submission Detail with PDF Export, Validation Link, and Attachments --}}

<div class="container-fluid py-4">
    {{!-- Header with action buttons --}}
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/admin/submissions">Submissions</a></li>
                    <li class="breadcrumb-item active">{{submission.clientName}}</li>
                </ol>
            </nav>
            <h2 class="mb-1">
                <i class="bi bi-file-earmark-text me-2"></i>
                Submission Details
            </h2>
            <p class="text-muted mb-0">
                {{submission.formName}} - {{submission.clientName}}
            </p>
        </div>
        
        {{!-- Action buttons --}}
        <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/submissions/{{submission.id}}/export-pdf" class="btn btn-primary">
                <i class="bi bi-file-pdf me-1"></i> Export PDF
            </a>
            <a href="/admin/submissions/{{submission.id}}/validation" class="btn btn-success">
                <i class="bi bi-check2-square me-1"></i> Implementation Validation
            </a>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#attachmentModal">
                <i class="bi bi-paperclip me-1"></i> Attach File
            </button>
            <a href="/admin/submissions" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    <div class="row">
        {{!-- Main content --}}
        <div class="col-lg-8">
            {{!-- Submission Info Card --}}
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Submission Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <th class="text-muted ps-0" style="width: 40%;">Client Name:</th>
                                    <td>{{submission.clientName}}</td>
                                </tr>
                                <tr>
                                    <th class="text-muted ps-0">Company:</th>
                                    <td>{{submission.companyName}}</td>
                                </tr>
                                <tr>
                                    <th class="text-muted ps-0">Email:</th>
                                    <td>
                                        {{#if submission.clientEmail}}
                                        <a href="mailto:{{submission.clientEmail}}">{{submission.clientEmail}}</a>
                                        {{else}}
                                        <span class="text-muted">N/A</span>
                                        {{/if}}
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <th class="text-muted ps-0" style="width: 40%;">Form:</th>
                                    <td>{{submission.formName}}</td>
                                </tr>
                                <tr>
                                    <th class="text-muted ps-0">Status:</th>
                                    <td>
                                        {{#eq submission.status 'submitted'}}
                                        <span class="badge bg-success">Submitted</span>
                                        {{else}}
                                        <span class="badge bg-warning">In Progress</span>
                                        {{/eq}}
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-muted ps-0">Progress:</th>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar" role="progressbar" style="width: {{submission.progress}}%">
                                                {{submission.progress}}%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            {{!-- Responses Card --}}
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-list-check me-2"></i>
                        Responses
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="responsesTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%; min-width: 200px;">Question / Field</th>
                                    <th style="width: 60%;">Response</th>
                                </tr>
                            </thead>
                            <tbody id="responsesTableBody">
                                {{!-- Populated by JavaScript --}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {{!-- Raw Data (collapsible) --}}
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <a class="text-decoration-none text-dark d-flex justify-content-between align-items-center" 
                       data-bs-toggle="collapse" href="#rawDataCollapse" role="button" aria-expanded="false">
                        <span>
                            <i class="bi bi-code-slash me-2"></i>
                            Raw JSON Data
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                </div>
                <div class="collapse" id="rawDataCollapse">
                    <div class="card-body">
                        <pre class="bg-dark text-light p-3 rounded mb-0" style="max-height: 400px; overflow-y: auto;"><code>{{dataJson}}</code></pre>
                    </div>
                </div>
            </div>
        </div>

        {{!-- Sidebar --}}
        <div class="col-lg-4">
            {{!-- Attachments Card --}}
            <div class="card mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="bi bi-paperclip me-2"></i>
                        Attachments
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#attachmentModal">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div id="attachmentsList">
                        {{#if attachments.length}}
                            {{#each attachments}}
                            <div class="attachment-item d-flex justify-content-between align-items-start p-2 border rounded mb-2" data-id="{{this.id}}">
                                <div class="flex-grow-1 me-2">
                                    <a href="{{this.fileUrl}}" target="_blank" rel="noopener noreferrer" class="text-decoration-none fw-semibold">
                                        <i class="bi bi-link-45deg me-1"></i>
                                        {{this.fileName}}
                                    </a>
                                    {{#if this.description}}
                                    <small class="d-block text-muted mt-1">{{this.description}}</small>
                                    {{/if}}
                                    <small class="d-block text-muted">
                                        Added by {{this.addedBy}}
                                    </small>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger delete-attachment" data-id="{{this.id}}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            {{/each}}
                        {{else}}
                            <p class="text-muted text-center mb-0" id="noAttachments">
                                <i class="bi bi-inbox d-block fs-2 mb-2"></i>
                                No attachments yet
                            </p>
                        {{/if}}
                    </div>
                </div>
            </div>

            {{!-- Quick Actions Card --}}
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="bi bi-lightning me-2"></i>
                        Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/admin/submissions/{{submission.id}}/export-pdf" class="btn btn-outline-primary">
                            <i class="bi bi-file-pdf me-2"></i>
                            Export as PDF
                        </a>
                        <a href="/admin/submissions/{{submission.id}}/validation" class="btn btn-outline-success">
                            <i class="bi bi-check2-square me-2"></i>
                            Implementation Validation
                        </a>
                        <a href="/admin/submissions/{{submission.id}}/validation/export-pdf" class="btn btn-outline-info">
                            <i class="bi bi-file-earmark-check me-2"></i>
                            Export Validation PDF
                        </a>
                        <hr>
                        {{!-- Validation Workflow --}}
                        {{#eq submission.status 'submitted'}}
                            {{#unless submission.validation_status}}
                            <form action="/admin/submissions/{{submission.id}}/send-for-validation" method="POST">
                                <button type="submit" class="btn btn-warning w-100">
                                    <i class="bi bi-send me-2"></i>
                                    Send to Client for Validation
                                </button>
                            </form>
                            {{/unless}}
                        {{/eq}}
                        
                        {{#eq submission.validation_status 'pending_user_validation'}}
                        <div class="alert alert-warning mb-2 py-2">
                            <small><i class="bi bi-hourglass-split me-1"></i> Waiting for client validation</small>
                        </div>
                        <div class="input-group input-group-sm mb-2">
                            <input type="text" class="form-control form-control-sm" id="validationLink" 
                                   value="/validate/submission/{{submission.inviteCode}}/{{submission.id}}/validate" readonly>
                            <button class="btn btn-outline-secondary" type="button" onclick="copyValidationLink()">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                        <small class="text-muted d-block mb-2">Share this link with the client</small>
                        <form action="/admin/submissions/{{submission.id}}/send-for-validation" method="POST">
                            <button type="submit" class="btn btn-outline-warning w-100 btn-sm">
                                <i class="bi bi-envelope me-1"></i>
                                Resend Validation Email
                            </button>
                        </form>
                        {{/eq}}
                        
                        {{#eq submission.validation_status 'user_submitted'}}
                        <div class="alert alert-success mb-2 py-2">
                            <small><i class="bi bi-check-circle me-1"></i> Client has completed validation</small>
                        </div>
                        <a href="/admin/submissions/{{submission.id}}/user-validation" class="btn btn-outline-info w-100 mb-2">
                            <i class="bi bi-eye me-2"></i>
                            View Client Validation
                        </a>
                        <form action="/admin/submissions/{{submission.id}}/send-for-validation" method="POST">
                            <button type="submit" class="btn btn-outline-warning w-100">
                                <i class="bi bi-arrow-repeat me-2"></i>
                                Send Back for Re-validation
                            </button>
                        </form>
                        {{/eq}}
                        <hr>
                        <form action="/admin/submissions/{{submission.id}}/delete" method="POST" 
                              onsubmit="return confirm('Are you sure you want to delete this submission? This cannot be undone.');">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-trash me-2"></i>
                                Delete Submission
                            </button>
                        </form>
                    </div>
                </div>
            </div>

<script>
function copyValidationLink() {
    const linkInput = document.getElementById('validationLink');
    const fullUrl = window.location.origin + linkInput.value;
    navigator.clipboard.writeText(fullUrl);
    
    const btn = event.target.closest('button');
    const originalHtml = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check"></i>';
    btn.classList.add('btn-success');
    btn.classList.remove('btn-outline-secondary');
    
    setTimeout(() => {
        btn.innerHTML = originalHtml;
        btn.classList.remove('btn-success');
        btn.classList.add('btn-outline-secondary');
    }, 2000);
}
</script>

            {{!-- Timeline Card --}}
            <div class="card">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>
                        Timeline
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        {{#if submission.started_at}}
                        <li class="pb-3 border-start ps-3 position-relative">
                            <span class="position-absolute bg-primary rounded-circle" style="left: -5px; top: 5px; width: 10px; height: 10px;"></span>
                            <strong>Started</strong>
                            <small class="d-block text-muted">{{formatDate submission.started_at}}</small>
                        </li>
                        {{/if}}
                        {{#if submission.updated_at}}
                        <li class="pb-3 border-start ps-3 position-relative">
                            <span class="position-absolute bg-info rounded-circle" style="left: -5px; top: 5px; width: 10px; height: 10px;"></span>
                            <strong>Last Updated</strong>
                            <small class="d-block text-muted">{{formatDate submission.updated_at}}</small>
                        </li>
                        {{/if}}
                        {{#if submission.submitted_at}}
                        <li class="ps-3 position-relative">
                            <span class="position-absolute bg-success rounded-circle" style="left: -5px; top: 5px; width: 10px; height: 10px;"></span>
                            <strong>Submitted</strong>
                            <small class="d-block text-muted">{{formatDate submission.submitted_at}}</small>
                        </li>
                        {{/if}}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

{{!-- Attachment Modal --}}
<div class="modal fade" id="attachmentModal" tabindex="-1" aria-labelledby="attachmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="attachmentModalLabel">
                    <i class="bi bi-link-45deg me-2"></i>
                    Add File Link
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">
                    Add a link to a supporting document (e.g., SharePoint, Google Drive, OneDrive)
                </p>
                <form id="attachmentForm">
                    <div class="mb-3">
                        <label for="fileName" class="form-label">File Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="fileName" name="fileName" required
                               placeholder="e.g., Project Charter.docx">
                    </div>
                    <div class="mb-3">
                        <label for="fileUrl" class="form-label">File URL <span class="text-danger">*</span></label>
                        <input type="url" class="form-control" id="fileUrl" name="fileUrl" required
                               placeholder="https://sharepoint.com/sites/...">
                        <div class="form-text">Full URL to the file</div>
                    </div>
                    <div class="mb-3">
                        <label for="fileDescription" class="form-label">Description (optional)</label>
                        <textarea class="form-control" id="fileDescription" name="description" rows="2"
                                  placeholder="Brief description..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveAttachment">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Link
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.table th, .table td {
    vertical-align: top;
    white-space: normal !important;
    word-wrap: break-word !important;
}

.attachment-item:hover {
    background-color: #f8f9fa;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const submissionId = '{{submission.id}}';
    const parsedData = {{{json parsedData}}};
    
    // Build responses table
    const tbody = document.getElementById('responsesTableBody');
    for (const [key, value] of Object.entries(parsedData)) {
        if (key.startsWith('_') || key === 'metadata') continue;
        
        const label = key
            .replace(/_/g, ' ')
            .replace(/([A-Z])/g, ' $1')
            .replace(/^./, str => str.toUpperCase())
            .trim();
        
        let displayValue = '';
        if (typeof value === 'boolean') {
            displayValue = value 
                ? '<span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Yes</span>' 
                : '<span class="badge bg-danger"><i class="bi bi-x-lg me-1"></i>No</span>';
        } else if (typeof value === 'object' && value !== null) {
            displayValue = '<pre class="mb-0 bg-light p-2 rounded small">' + JSON.stringify(value, null, 2) + '</pre>';
        } else if (value) {
            displayValue = String(value);
        } else {
            displayValue = '<span class="text-muted fst-italic">No response</span>';
        }
        
        const row = document.createElement('tr');
        row.innerHTML = `
            <td class="fw-semibold">${label}</td>
            <td>${displayValue}</td>
        `;
        tbody.appendChild(row);
    }
    
    // Attachment modal
    const attachmentModal = document.getElementById('attachmentModal') ? new bootstrap.Modal(document.getElementById('attachmentModal')) : null;
    
    // Save attachment
    document.getElementById('saveAttachment')?.addEventListener('click', async function() {
        const fileName = document.getElementById('fileName').value.trim();
        const fileUrl = document.getElementById('fileUrl').value.trim();
        const description = document.getElementById('fileDescription').value.trim();
        
        if (!fileName || !fileUrl) {
            alert('Please fill in the required fields');
            return;
        }
        
        try {
            const response = await fetch(`/admin/submissions/${submissionId}/attachments`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fileName, fileUrl, description })
            });
            
            const result = await response.json();
            
            if (result.success) {
                const attachmentsList = document.getElementById('attachmentsList');
                const noAttachments = document.getElementById('noAttachments');
                if (noAttachments) noAttachments.remove();
                
                const newItem = document.createElement('div');
                newItem.className = 'attachment-item d-flex justify-content-between align-items-start p-2 border rounded mb-2';
                newItem.dataset.id = result.attachment.id;
                newItem.innerHTML = `
                    <div class="flex-grow-1 me-2">
                        <a href="${fileUrl}" target="_blank" rel="noopener noreferrer" class="text-decoration-none fw-semibold">
                            <i class="bi bi-link-45deg me-1"></i>${fileName}
                        </a>
                        ${description ? `<small class="d-block text-muted mt-1">${description}</small>` : ''}
                        <small class="d-block text-muted">Added just now</small>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger delete-attachment" data-id="${result.attachment.id}">
                        <i class="bi bi-trash"></i>
                    </button>
                `;
                attachmentsList.appendChild(newItem);
                
                document.getElementById('attachmentForm').reset();
                if (attachmentModal) attachmentModal.hide();
            } else {
                alert(result.error || 'Error adding attachment');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error adding attachment');
        }
    });
    
    // Delete attachment
    document.getElementById('attachmentsList')?.addEventListener('click', async function(e) {
        const deleteBtn = e.target.closest('.delete-attachment');
        if (!deleteBtn) return;
        
        if (!confirm('Remove this attachment?')) return;
        
        const attachmentId = deleteBtn.dataset.id;
        
        try {
            const response = await fetch(`/admin/submissions/${submissionId}/attachments/${attachmentId}`, {
                method: 'DELETE'
            });
            
            const result = await response.json();
            
            if (result.success) {
                deleteBtn.closest('.attachment-item').remove();
                
                if (!document.querySelector('.attachment-item')) {
                    document.getElementById('attachmentsList').innerHTML = `
                        <p class="text-muted text-center mb-0" id="noAttachments">
                            <i class="bi bi-inbox d-block fs-2 mb-2"></i>
                            No attachments yet
                        </p>
                    `;
                }
            } else {
                alert(result.error || 'Error deleting attachment');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error deleting attachment');
        }
    });
});
</script>
