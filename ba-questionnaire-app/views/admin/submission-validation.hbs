        <div class="modal-content">
            <div class="modal-header text-white" style="background: #9b59b6;">
                <h5 class="modal-title"><i class="bi bi-award me-2"></i>Send for Approval</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="approvalStep1">
                    <p class="text-muted mb-3"><i class="bi bi-info-circle me-1"></i>Approvals: Client → Sponsor → Executive</p>
                    
                    <div class="card mb-2 border-primary">
                        <div class="card-header bg-primary text-white py-2"><span class="badge bg-white text-primary me-2">1</span>Client</div>
                        <div class="card-body py-2">
                            <div class="row g-2">
                                <div class="col-6"><input type="text" class="form-control form-control-sm" value="{{submission.clientName}}" readonly style="background:#e9ecef;"></div>
                                <div class="col-6"><input type="email" class="form-control form-control-sm" value="{{submission.clientEmail}}" readonly style="background:#e9ecef;"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card mb-2 border-warning">
                        <div class="card-header bg-warning py-2"><span class="badge bg-white text-warning me-2">2</span>Sponsor</div>
                        <div class="card-body py-2">
                            <div class="row g-2">
                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="Name" id="sponsorName"></div>
                                <div class="col-6"><input type="email" class="form-control form-control-sm" placeholder="Email" id="sponsorEmail"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card mb-2 border-secondary">
                        <div class="card-header bg-secondary text-white py-2"><span class="badge bg-white text-secondary me-2">3</span>Executive</div>
                        <div class="card-body py-2">
                            <div class="row g-2">
                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="Name" id="executiveName"></div>
                                <div class="col-6"><input type="email" class="form-control form-control-sm" placeholder="Email" id="executiveEmail"></div>
                            </div>
                        </div>
