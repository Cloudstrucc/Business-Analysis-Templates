                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn text-white" style="background: #9b59b6;" id="generateApprovalLinks">
                    <i class="bi bi-send me-1"></i> Generate Links
                </button>
            </div>
        </div>
    </div>
