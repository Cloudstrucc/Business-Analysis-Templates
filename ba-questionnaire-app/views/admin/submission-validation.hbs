                <div class="card mb-2"><div class="card-body py-2 d-flex justify-content-between"><span><span class="badge bg-warning text-dark me-2">2</span>{{approvalStatus.sponsor_name}}</span>{{#if approvalStatus.sponsor_approved_at}}<span class="badge bg-success">✓</span>{{else}}<span class="badge bg-warning text-dark">Pending</span>{{/if}}</div></div>
                <div class="card mb-2"><div class="card-body py-2 d-flex justify-content-between"><span><span class="badge bg-secondary me-2">3</span>{{approvalStatus.executive_name}}</span>{{#if approvalStatus.executive_approved_at}}<span class="badge bg-success">✓</span>{{else}}<span class="badge bg-secondary">Pending</span>{{/if}}</div></div>
