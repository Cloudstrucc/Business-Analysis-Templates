<!-- Audit History Modal -->
<div class="modal fade" id="auditHistoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="bi bi-clock-history me-2"></i>History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="max-height: 400px; overflow-y: auto;">
                {{#if auditLog.length}}
                {{#each auditLog}}
                <div class="mb-2 pb-2 border-bottom">
                    <span class="badge bg-secondary">{{action}}</span>
                    <strong class="ms-2">{{actor}}</strong>
                    <small class="text-muted float-end">{{created_at}}</small>
                </div>
                {{/each}}
                {{else}}
                <p class="text-muted text-center py-4">No history yet.</p>
                {{/if}}
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
        </div>
    </div>
</div>

<script>
// Visible field keys for re-validation (server provides this)
const visibleFieldKeys = {{{json visibleFieldKeys}}};
const validationData = {{{json validationData}}};
let hasChanges = false;

// Track changes
document.querySelectorAll('.validation-radio').forEach(radio => {
    radio.addEventListener('change', () => { hasChanges = true; updateSaveStatus(); });
});

document.querySelectorAll('.comment-editor').forEach(editor => {
    editor.addEventListener('input', () => { hasChanges = true; updateSaveStatus(); });
});

function updateSaveStatus() {
    const status = document.getElementById('saveStatus');
    if (hasChanges) {
        status.innerHTML = '<i class="bi bi-exclamation-circle text-warning me-1"></i>You have unsaved changes';
    }
}

// Save validation
function saveValidation() {
    const data = {};
    
    // Collect from current page
    document.querySelectorAll('.validation-row').forEach(row => {
        const field = row.dataset.field;
        const yesRadio = document.getElementById('y_' + field);
        const noRadio = document.getElementById('n_' + field);
        const editor = row.querySelector('.comment-editor');
        
        let met = null;
        if (yesRadio && yesRadio.checked) met = 'yes';
        else if (noRadio && noRadio.checked) met = 'no';
        
        data[field] = {
            met,
            comment: editor ? editor.innerHTML.trim() : ''
        };
    });
    
    // Merge with existing validation data (for fields not on this page)
    const merged = { ...validationData, ...data };
    
    document.getElementById('validationDataInput').value = JSON.stringify(merged);
    document.getElementById('validationForm').submit();
}

// Send for re-validation
function sendForRevalidation() {
    const modal = new bootstrap.Modal(document.getElementById('revalidationModal'));
    modal.show();
}

document.getElementById('confirmRevalidationBtn').addEventListener('click', async function() {
    this.disabled = true;
    this.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sending...';
    
    try {
        const res = await fetch('/admin/submissions/{{submission.id}}/send-for-validation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                filteredFields: visibleFieldKeys,
                message: document.getElementById('revalidationMessage').value
            })
        });
        
        const result = await res.json();
        if (result.success) {
            alert('Sent ' + result.fieldCount + ' items for re-validation!');
            window.location.reload();
        } else {
            alert('Error: ' + (result.error || 'Failed'));
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-send me-1"></i>Send to Client';
        }
    } catch (err) {
        alert('Error sending request');
        this.disabled = false;
        this.innerHTML = '<i class="bi bi-send me-1"></i>Send to Client';
    }
});

// Approval workflow
document.getElementById('generateApprovalLinks')?.addEventListener('click', async function() {
    const sn = document.getElementById('sponsorName').value.trim();
    const se = document.getElementById('sponsorEmail').value.trim();
    const en = document.getElementById('executiveName').value.trim();
    const ee = document.getElementById('executiveEmail').value.trim();
    
    if (!sn || !se || !en || !ee) return alert('Fill all fields');
    
    this.disabled = true;
    this.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>...';
    
    try {
        const res = await fetch('/admin/submissions/{{submission.id}}/approval', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sponsorName: sn, sponsorEmail: se, executiveName: en, executiveEmail: ee })
        });
        
        const result = await res.json();
        if (result.success) {
            document.getElementById('approvalStep1').style.display = 'none';
            document.getElementById('approvalStep2').style.display = 'block';
            this.style.display = 'none';
            document.getElementById('approvalLinksContainer').innerHTML = `
                <div class="card mb-2"><div class="card-body py-2"><strong>${result.approvalLinks.client.name}</strong><br><input class="form-control form-control-sm mt-1" value="${result.approvalLinks.client.link}" readonly onclick="this.select();document.execCommand('copy');"></div></div>
                <div class="card mb-2"><div class="card-body py-2"><strong>${result.approvalLinks.sponsor.name}</strong><br><input class="form-control form-control-sm mt-1" value="${result.approvalLinks.sponsor.link}" readonly onclick="this.select();document.execCommand('copy');"></div></div>
                <div class="card mb-2"><div class="card-body py-2"><strong>${result.approvalLinks.executive.name}</strong><br><input class="form-control form-control-sm mt-1" value="${result.approvalLinks.executive.link}" readonly onclick="this.select();document.execCommand('copy');"></div></div>
            `;
        } else {
            alert('Error: ' + (result.error || 'Failed'));
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-send me-1"></i>Generate Links';
        }
    } catch (err) {
        alert('Error');
        this.disabled = false;
        this.innerHTML = '<i class="bi bi-send me-1"></i>Generate Links';
    }
});

// Warn before leaving with unsaved changes
window.addEventListener('beforeunload', e => {
    if (hasChanges) { e.preventDefault(); e.returnValue = ''; }
});
</script>
