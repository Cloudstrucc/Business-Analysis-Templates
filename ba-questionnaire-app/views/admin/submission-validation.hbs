{{!-- views/admin/submission-validation.hbs --}}
{{!-- Implementation Validation Page with save confirmation, completion status, and approval workflow --}}

<div class="container py-4">
    {{!-- Header --}}
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/admin/submissions">Submissions</a></li>
                    <li class="breadcrumb-item"><a href="/admin/submissions/{{submission.id}}">{{submission.clientName}}</a></li>
                    <li class="breadcrumb-item active">Validation</li>
                </ol>
            </nav>
            <h2 class="mb-1">
                <i class="bi bi-check2-square me-2"></i>
                Implementation Validation
            </h2>
            <p class="text-muted mb-0">
                Validate requirements for {{submission.clientName}} - {{submission.formName}}
            </p>
        </div>
        
        <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/submissions/{{submission.id}}/validation/export-pdf" class="btn btn-primary">
                <i class="bi bi-file-pdf me-1"></i> Export Validation PDF
            </a>
            {{!-- Send for Approval button (only if validation complete and no approval yet) --}}
            {{#if validationComplete}}
                {{#unless approvalStatus}}
                <button type="button" class="btn text-white" style="background: #9b59b6;" data-bs-toggle="modal" data-bs-target="#sendForApprovalModal">
                    <i class="bi bi-award me-1"></i> Send for Approval
                </button>
                {{/unless}}
            {{/if}}
            {{#if approvalStatus}}
            <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#approvalStatusModal">
                <i class="bi bi-award me-1"></i> View Approval Status
            </button>
            {{/if}}
            <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#auditHistoryModal">
                <i class="bi bi-clock-history me-1"></i> History
            </button>
            <a href="/admin/submissions/{{submission.id}}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Submission
            </a>
        </div>
    </div>

    {{!-- Approval Status Banner (if approval exists) --}}
    {{#if approvalStatus}}
    <div class="alert mb-4 {{#if approvalStatus.isComplete}}alert-success{{else}}alert-info{{/if}}">
        <div class="d-flex align-items-center">
            <i class="bi {{#if approvalStatus.isComplete}}bi-check-circle-fill{{else}}bi-hourglass-split{{/if}} fs-4 me-3"></i>
            <div class="flex-grow-1">
                {{#if approvalStatus.isComplete}}
                <h6 class="mb-0"><i class="bi bi-trophy me-1"></i> Project Fully Approved!</h6>
                <small class="text-muted">All 3 stakeholders have approved the implementation.</small>
                {{else}}
                <h6 class="mb-0">Approval In Progress</h6>
                <small class="text-muted">{{approvalStatus.approvedCount}} of 3 stakeholders have approved.</small>
                {{/if}}
            </div>
            <button type="button" class="btn btn-sm {{#if approvalStatus.isComplete}}btn-success{{else}}btn-info{{/if}}" data-bs-toggle="modal" data-bs-target="#approvalStatusModal">
                View Details
            </button>
        </div>
    </div>
    {{/if}}

    {{!-- Completion Banner (shown when 100% validated) --}}
    <div class="alert alert-success d-none mb-4" id="completionBanner">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <i class="bi bi-check-circle-fill fs-3 me-3"></i>
            <div class="flex-grow-1">
                <h5 class="mb-1">Validation Complete!</h5>
                <p class="mb-0">All requirements have been validated. You can now export the validation report or send for approval.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/admin/submissions/{{submission.id}}/validation/export-pdf" class="btn btn-success">
                    <i class="bi bi-file-pdf me-1"></i> Export PDF Report
                </a>
                {{#unless approvalStatus}}
                <button type="button" class="btn text-white" style="background: #9b59b6;" data-bs-toggle="modal" data-bs-target="#sendForApprovalModal" id="completionApprovalBtn">
                    <i class="bi bi-award me-1"></i> Send for Approval
                </button>
                {{/unless}}
            </div>
        </div>
    </div>

    {{!-- Validation Summary Cards --}}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-body text-center py-3">
                    <h6 class="text-muted mb-1">Total Requirements</h6>
                    <h3 class="mb-0" id="totalCount">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center py-3">
                    <h6 class="mb-1">Requirements Met</h6>
                    <h3 class="mb-0" id="metCount">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body text-center py-3">
                    <h6 class="mb-1">Requirements Not Met</h6>
                    <h3 class="mb-0" id="notMetCount">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body text-center py-3">
                    <h6 class="mb-1">Not Validated</h6>
                    <h3 class="mb-0" id="pendingCount">0</h3>
                </div>
            </div>
        </div>
    </div>

    {{!-- Progress Bar --}}
    <div class="mb-4">
        <div class="d-flex justify-content-between mb-1">
            <span>Validation Progress</span>
            <span id="progressPercent">0%</span>
        </div>
        <div class="progress" style="height: 24px;">
            <div class="progress-bar bg-success" role="progressbar" id="progressBarMet" style="width: 0%">
                <span id="progressBarMetLabel"></span>
            </div>
            <div class="progress-bar bg-danger" role="progressbar" id="progressBarNotMet" style="width: 0%">
                <span id="progressBarNotMetLabel"></span>
            </div>
        </div>
    </div>

    {{!-- Validation Form --}}
    <form id="validationForm" method="POST" action="/admin/submissions/{{submission.id}}/validation">
        <div class="card">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-clipboard-check me-2"></i>
                    Requirements Validation
                </h5>
                <div>
                    <button type="button" class="btn btn-sm btn-light me-2" id="markAllMet">
                        <i class="bi bi-check-all me-1"></i> Mark All Met
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="clearAll">
                        <i class="bi bi-x-lg me-1"></i> Clear All
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 validation-table">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th style="width: 25%;">Requirement</th>
                                <th style="width: 25%;">Client Response</th>
                                <th style="width: 15%; text-align: center;">Requirement Met</th>
                                <th style="width: 30%;">Comments</th>
                            </tr>
                        </thead>
                        <tbody id="validationTableBody">
                            {{!-- Rows populated by JavaScript --}}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted" id="saveStatus">
                            <i class="bi bi-info-circle me-1"></i>
                            Click "Save Validation" to save your changes
                        </span>
                    </div>
                    <div>
                        <a href="/admin/submissions/{{submission.id}}" class="btn btn-outline-secondary me-2">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-success btn-lg" id="saveBtn">
                            <i class="bi bi-check-lg me-1"></i>
                            Save Validation
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <input type="hidden" name="validationData" id="validationDataInput" value="">
    </form>
</div>

{{!-- ============================================== --}}
{{!-- MODAL: Send for Approval                      --}}
{{!-- ============================================== --}}
<div class="modal fade" id="sendForApprovalModal" tabindex="-1" aria-labelledby="sendForApprovalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" style="background: #9b59b6;">
                <h5 class="modal-title" id="sendForApprovalModalLabel">
                    <i class="bi bi-award me-2"></i>
                    Send for Approval
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{!-- Step 1: Form --}}
                <div id="approvalStep1">
                    <p class="text-muted mb-4">
                        <i class="bi bi-info-circle me-1"></i>
                        Enter the stakeholder information below to generate approval links. Approvals must be completed in order: Client → Project Sponsor → Executive.
                    </p>
                    
                    {{!-- Stakeholder 1: Client (Pre-populated) --}}
                    <div class="card mb-3 border-primary">
                        <div class="card-header bg-primary text-white py-2">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-white text-primary me-2 rounded-circle" style="width: 24px; height: 24px; line-height: 18px;">1</span>
                                <strong>Client</strong>
                                <span class="badge bg-light text-primary ms-auto">Pre-populated from submission</span>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <div class="row">
                                <div class="col-md-6 mb-2 mb-md-0">
                                    <label class="form-label small mb-1">Full Name</label>
                                    <input type="text" class="form-control form-control-sm" id="clientName" value="{{submission.clientName}}" readonly style="background: #e9ecef;">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small mb-1">Email</label>
                                    <input type="email" class="form-control form-control-sm" id="clientEmail" value="{{submission.clientEmail}}" readonly style="background: #e9ecef;">
                                </div>
                            </div>
                            <small class="text-muted mt-2 d-block"><i class="bi bi-info-circle me-1"></i>This is the client who submitted the questionnaire</small>
                        </div>
                    </div>
                    
                    {{!-- Stakeholder 2: Project Sponsor --}}
                    <div class="card mb-3 border-warning">
                        <div class="card-header bg-warning py-2">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-white text-warning me-2 rounded-circle" style="width: 24px; height: 24px; line-height: 18px;">2</span>
                                <strong>Project Sponsor</strong>
                                <span class="badge bg-light text-warning ms-auto">Required</span>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <div class="row">
                                <div class="col-md-6 mb-2 mb-md-0">
                                    <label class="form-label small mb-1">Full Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm" placeholder="Enter full name..." id="sponsorName" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small mb-1">Email <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control form-control-sm" placeholder="sponsor@company.com" id="sponsorEmail" required>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    {{!-- Stakeholder 3: Executive --}}
                    <div class="card mb-3 border-secondary">
                        <div class="card-header bg-secondary text-white py-2">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-white text-secondary me-2 rounded-circle" style="width: 24px; height: 24px; line-height: 18px;">3</span>
                                <strong>Executive</strong>
                                <span class="badge bg-light text-secondary ms-auto">Required</span>
                            </div>
                        </div>
                        <div class="card-body py-3">
                            <div class="row">
                                <div class="col-md-6 mb-2 mb-md-0">
                                    <label class="form-label small mb-1">Full Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-sm" placeholder="Enter full name..." id="executiveName" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small mb-1">Email <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control form-control-sm" placeholder="executive@company.com" id="executiveEmail" required>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                {{!-- Step 2: Links Generated --}}
                <div id="approvalStep2" style="display: none;">
                    <div class="alert alert-success mb-4">
                        <i class="bi bi-check-circle me-2"></i>
                        <strong>Success!</strong> Approval links have been generated. Share these links with each stakeholder to collect approvals.
                    </div>
                    
                    <p class="text-muted mb-4">
                        <i class="bi bi-info-circle me-1"></i>
                        Approvals must be completed in sequence. Each stakeholder can only approve after the previous one has approved.
                    </p>
                    
                    <div id="approvalLinksContainer">
                        {{!-- Populated by JavaScript --}}
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn text-white" style="background: #9b59b6;" id="generateApprovalLinks">
                    <i class="bi bi-send me-1"></i> Generate Approval Links
                </button>
            </div>
        </div>
    </div>
</div>

{{!-- ============================================== --}}
{{!-- MODAL: Approval Status                        --}}
{{!-- ============================================== --}}
{{#if approvalStatus}}
<div class="modal fade" id="approvalStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" style="background: #9b59b6;">
                <h5 class="modal-title">
                    <i class="bi bi-award me-2"></i>
                    Approval Status
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h6 class="mb-1">Progress</h6>
                        <span class="text-muted">{{approvalStatus.approvedCount}} of 3 approvals complete</span>
                    </div>
                    {{#if approvalStatus.isComplete}}
                    <span class="badge bg-success fs-6 px-3 py-2">
                        <i class="bi bi-trophy me-1"></i> Fully Approved
                    </span>
                    {{else}}
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                        <i class="bi bi-hourglass-split me-1"></i> In Progress
                    </span>
                    {{/if}}
                </div>
                
                {{!-- Client --}}
                <div class="card mb-3 {{#if approvalStatus.client_approved_at}}border-success{{else}}border-warning{{/if}}">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-primary me-2 rounded-circle" style="width: 24px; height: 24px; line-height: 18px;">1</span>
                            <div class="flex-grow-1">
                                <strong>{{approvalStatus.client_name}}</strong> <span class="badge bg-primary">Client</span>
                                <br><small class="text-muted">{{approvalStatus.client_email}}</small>
                            </div>
                            {{#if approvalStatus.client_approved_at}}
                            <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Approved</span>
                            {{else}}
                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                            {{/if}}
                        </div>
                        {{#if approvalStatus.client_approved_at}}
                        <small class="text-muted d-block mt-2">Approved on {{approvalStatus.client_approved_at}}</small>
                        {{/if}}
                    </div>
                </div>
                
                {{!-- Sponsor --}}
                <div class="card mb-3 {{#if approvalStatus.sponsor_approved_at}}border-success{{else}}border-warning{{/if}}">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-warning text-dark me-2 rounded-circle" style="width: 24px; height: 24px; line-height: 18px;">2</span>
                            <div class="flex-grow-1">
                                <strong>{{approvalStatus.sponsor_name}}</strong> <span class="badge bg-warning text-dark">Project Sponsor</span>
                                <br><small class="text-muted">{{approvalStatus.sponsor_email}}</small>
                            </div>
                            {{#if approvalStatus.sponsor_approved_at}}
                            <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Approved</span>
                            {{else}}
                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                            {{/if}}
                        </div>
                        {{#if approvalStatus.sponsor_approved_at}}
                        <small class="text-muted d-block mt-2">Approved on {{approvalStatus.sponsor_approved_at}}</small>
                        {{/if}}
                    </div>
                </div>
                
                {{!-- Executive --}}
                <div class="card mb-3 {{#if approvalStatus.executive_approved_at}}border-success{{else}}border-secondary{{/if}}">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-secondary me-2 rounded-circle" style="width: 24px; height: 24px; line-height: 18px;">3</span>
                            <div class="flex-grow-1">
                                <strong>{{approvalStatus.executive_name}}</strong> <span class="badge bg-secondary">Executive</span>
                                <br><small class="text-muted">{{approvalStatus.executive_email}}</small>
                            </div>
                            {{#if approvalStatus.executive_approved_at}}
                            <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Approved</span>
                            {{else}}
                            <span class="badge bg-secondary"><i class="bi bi-clock me-1"></i>Pending</span>
                            {{/if}}
                        </div>
                        {{#if approvalStatus.executive_approved_at}}
                        <small class="text-muted d-block mt-2">Approved on {{approvalStatus.executive_approved_at}}</small>
                        {{/if}}
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
{{/if}}

{{!-- ============================================== --}}
{{!-- MODAL: Audit History                          --}}
{{!-- ============================================== --}}
<div class="modal fade" id="auditHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title"><i class="bi bi-clock-history me-2"></i>Validation History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {{#if auditLog.length}}
                <div class="audit-timeline">
                    {{#each auditLog}}
                    <div class="audit-item mb-3 pb-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge 
                                    {{#if (eq action 'submitted')}}bg-primary
                                    {{else if (eq action 'admin_validated')}}bg-success
                                    {{else if (eq action 'approval_initiated')}}bg-info
                                    {{else if (eq action 'client_approved')}}bg-success
                                    {{else if (eq action 'sponsor_approved')}}bg-success
                                    {{else if (eq action 'executive_approved')}}bg-success
                                    {{else if (eq action 'approval_completed')}}bg-success
                                    {{else}}bg-secondary{{/if}}">
                                    {{action}}
                                </span>
                                <strong class="ms-2">{{actor}}</strong>
                            </div>
                            <small class="text-muted">{{created_at}}</small>
                        </div>
                        {{#if details.comment}}
                        <p class="text-muted small mb-0 mt-1">{{details.comment}}</p>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <p class="text-muted text-center py-4">No history available yet.</p>
                {{/if}}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
.validation-table th,
.validation-table td {
    vertical-align: top;
    white-space: normal;
    word-wrap: break-word;
}

.rich-text-editor {
    min-height: 50px;
    max-height: 150px;
    overflow-y: auto;
    padding: 8px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    background: #fff;
    font-size: 0.9rem;
}

.rich-text-editor:empty:before {
    content: attr(data-placeholder);
    color: #999;
    font-style: italic;
}

.rich-text-editor:focus {
    outline: none;
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
}

.validation-row.validated-yes {
    background-color: rgba(25, 135, 84, 0.1) !important;
}

.validation-row.validated-no {
    background-color: rgba(220, 53, 69, 0.1) !important;
}

.validation-row.validated-yes td,
.validation-row.validated-no td {
    opacity: 1;
}

.validation-table thead {
    position: sticky;
    top: 0;
    z-index: 10;
}

.btn-group-validation .btn {
    padding: 0.375rem 0.75rem;
}

.format-toolbar {
    margin-top: 4px;
    opacity: 0.7;
}

.format-toolbar:hover {
    opacity: 1;
}

.format-toolbar .btn {
    padding: 0 0.35rem;
    font-size: 0.75rem;
}

.row-number {
    font-weight: bold;
    color: #6c757d;
}

/* Pulse animation for save button when changes are made */
@keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7); }
    70% { box-shadow: 0 0 0 10px rgba(25, 135, 84, 0); }
    100% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
}

.btn-pulse {
    animation: pulse 1.5s infinite;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const parsedData = {{{json parsedData}}};
    const validationData = {{{json validationData}}};
    
    const tbody = document.getElementById('validationTableBody');
    let rowNum = 0;
    let hasChanges = false;
    
    // Build table rows
    for (const [key, value] of Object.entries(parsedData)) {
        if (key.startsWith('_') || key === 'metadata') continue;
        
        rowNum++;
        
        const label = key
            .replace(/_/g, ' ')
            .replace(/([A-Z])/g, ' $1')
            .replace(/^./, str => str.toUpperCase())
            .trim();
        
        const fieldValidation = validationData[key] || {};
        const isMet = fieldValidation.met === 'yes';
        const isNotMet = fieldValidation.met === 'no';
        const comment = fieldValidation.comment || '';
        
        let displayValue = '';
        if (typeof value === 'boolean') {
            displayValue = value 
                ? '<span class="badge bg-success"><i class="bi bi-check-lg"></i> Yes</span>' 
                : '<span class="badge bg-danger"><i class="bi bi-x-lg"></i> No</span>';
        } else if (typeof value === 'object' && value !== null) {
            displayValue = '<pre class="mb-0 bg-light p-2 rounded small" style="white-space: pre-wrap; max-height: 100px; overflow-y: auto;">' + JSON.stringify(value, null, 2) + '</pre>';
        } else if (value) {
            displayValue = '<span class="text-break">' + String(value) + '</span>';
        } else {
            displayValue = '<span class="text-muted fst-italic">No response</span>';
        }
        
        const row = document.createElement('tr');
        row.className = 'validation-row' + (isMet ? ' validated-yes' : '') + (isNotMet ? ' validated-no' : '');
        row.dataset.field = key;
        
        row.innerHTML = `
            <td class="row-number">${rowNum}</td>
            <td><strong>${label}</strong></td>
            <td>${displayValue}</td>
            <td class="text-center">
                <div class="btn-group btn-group-validation" role="group">
                    <input type="radio" class="btn-check validation-check" name="validation_${key}" 
                           id="yes_${key}" value="yes" ${isMet ? 'checked' : ''}>
                    <label class="btn btn-outline-success" for="yes_${key}" title="Requirement Met">
                        <i class="bi bi-check-lg"></i> Yes
                    </label>
                    <input type="radio" class="btn-check validation-check" name="validation_${key}" 
                           id="no_${key}" value="no" ${isNotMet ? 'checked' : ''}>
                    <label class="btn btn-outline-danger" for="no_${key}" title="Requirement Not Met">
                        <i class="bi bi-x-lg"></i> No
                    </label>
                </div>
            </td>
            <td>
                <div class="rich-text-editor" 
                     contenteditable="true" 
                     data-field="${key}"
                     data-placeholder="Add comments...">${comment}</div>
                <div class="format-toolbar">
                    <button type="button" class="btn btn-link btn-sm text-secondary format-btn p-0 me-1" data-command="bold" title="Bold"><i class="bi bi-type-bold"></i></button>
                    <button type="button" class="btn btn-link btn-sm text-secondary format-btn p-0 me-1" data-command="italic" title="Italic"><i class="bi bi-type-italic"></i></button>
                    <button type="button" class="btn btn-link btn-sm text-secondary format-btn p-0" data-command="insertUnorderedList" title="List"><i class="bi bi-list-ul"></i></button>
                </div>
            </td>
        `;
        
        tbody.appendChild(row);
    }
    
    // Update stats
    function updateStats() {
        const rows = document.querySelectorAll('.validation-row');
        let total = rows.length;
        let met = 0;
        let notMet = 0;
        let pending = 0;

        rows.forEach(row => {
            const yesRadio = row.querySelector('input[value="yes"]');
            const noRadio = row.querySelector('input[value="no"]');
            
            row.classList.remove('validated-yes', 'validated-no');
            
            if (yesRadio && yesRadio.checked) {
                met++;
                row.classList.add('validated-yes');
            } else if (noRadio && noRadio.checked) {
                notMet++;
                row.classList.add('validated-no');
            } else {
                pending++;
            }
        });

        document.getElementById('totalCount').textContent = total;
        document.getElementById('metCount').textContent = met;
        document.getElementById('notMetCount').textContent = notMet;
        document.getElementById('pendingCount').textContent = pending;

        const validated = met + notMet;
        const percentValidated = total > 0 ? Math.round((validated / total) * 100) : 0;
        const percentMet = total > 0 ? Math.round((met / total) * 100) : 0;
        const percentNotMet = total > 0 ? Math.round((notMet / total) * 100) : 0;
        
        document.getElementById('progressPercent').textContent = percentValidated + '% validated';
        document.getElementById('progressBarMet').style.width = percentMet + '%';
        document.getElementById('progressBarNotMet').style.width = percentNotMet + '%';
        
        // Show/hide completion banner and approval button
        const completionBanner = document.getElementById('completionBanner');
        const completionApprovalBtn = document.getElementById('completionApprovalBtn');
        if (pending === 0 && total > 0) {
            completionBanner.classList.remove('d-none');
        } else {
            completionBanner.classList.add('d-none');
        }
    }

    // Track changes
    function markChanged() {
        hasChanges = true;
        const saveBtn = document.getElementById('saveBtn');
        const saveStatus = document.getElementById('saveStatus');
        saveBtn.classList.add('btn-pulse');
        saveStatus.innerHTML = '<i class="bi bi-exclamation-circle text-warning me-1"></i> You have unsaved changes';
    }

    // Initial count
    updateStats();

    // Update on change
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('validation-check')) {
            updateStats();
            markChanged();
        }
    });

    // Track text changes
    document.querySelectorAll('.rich-text-editor').forEach(editor => {
        editor.addEventListener('input', markChanged);
    });

    // Mark all as met
    document.getElementById('markAllMet').addEventListener('click', function() {
        document.querySelectorAll('input[value="yes"]').forEach(input => {
            input.checked = true;
        });
        updateStats();
        markChanged();
    });

    // Clear all
    document.getElementById('clearAll').addEventListener('click', function() {
        if (!confirm('Clear all validation selections?')) return;
        document.querySelectorAll('.validation-check').forEach(input => {
            input.checked = false;
        });
        updateStats();
        markChanged();
    });

    // Rich text formatting
    document.addEventListener('click', function(e) {
        const btn = e.target.closest('.format-btn');
        if (btn) {
            e.preventDefault();
            document.execCommand(btn.dataset.command, false, null);
        }
    });

    // Build JSON before submit
    document.getElementById('validationForm').addEventListener('submit', function(e) {
        const validation = {};
        
        document.querySelectorAll('.validation-row').forEach(row => {
            const field = row.dataset.field;
            const yesRadio = row.querySelector('input[value="yes"]');
            const noRadio = row.querySelector('input[value="no"]');
            const editor = row.querySelector('.rich-text-editor');
            
            let met = null;
            if (yesRadio && yesRadio.checked) met = 'yes';
            else if (noRadio && noRadio.checked) met = 'no';
            
            const comment = editor ? editor.innerHTML.trim() : '';
            
            validation[field] = { met, comment };
        });
        
        document.getElementById('validationDataInput').value = JSON.stringify(validation);
        
        // Visual feedback
        const saveBtn = document.getElementById('saveBtn');
        saveBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Saving...';
        saveBtn.disabled = true;
    });

    // Warn before leaving with unsaved changes
    window.addEventListener('beforeunload', function(e) {
        if (hasChanges) {
            e.preventDefault();
            e.returnValue = '';
        }
    });
    
    // ==============================================
    // Approval Workflow
    // ==============================================
    const generateApprovalLinksBtn = document.getElementById('generateApprovalLinks');
    if (generateApprovalLinksBtn) {
        generateApprovalLinksBtn.addEventListener('click', async function() {
            const sponsorName = document.getElementById('sponsorName').value.trim();
            const sponsorEmail = document.getElementById('sponsorEmail').value.trim();
            const executiveName = document.getElementById('executiveName').value.trim();
            const executiveEmail = document.getElementById('executiveEmail').value.trim();
            
            if (!sponsorName || !sponsorEmail || !executiveName || !executiveEmail) {
                alert('Please fill in all stakeholder information.');
                return;
            }
            
            // Simple email validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(sponsorEmail) || !emailRegex.test(executiveEmail)) {
                alert('Please enter valid email addresses.');
                return;
            }
            
            // Disable button and show loading
            this.disabled = true;
            this.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Generating...';
            
            try {
                const response = await fetch('/admin/submissions/{{submission.id}}/approval', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sponsorName, sponsorEmail, executiveName, executiveEmail })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Hide step 1, show step 2
                    document.getElementById('approvalStep1').style.display = 'none';
                    document.getElementById('approvalStep2').style.display = 'block';
                    
                    // Hide the generate button
                    this.style.display = 'none';
                    
                    // Populate links
                    const container = document.getElementById('approvalLinksContainer');
                    container.innerHTML = `
                        <div class="card mb-3">
                            <div class="card-body py-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-primary me-2 rounded-circle" style="width: 24px; height: 24px; line-height: 18px;">1</span>
                                    <div class="flex-grow-1">
                                        <strong>${result.approvalLinks.client.name}</strong> <span class="badge bg-primary">Client</span>
                                        <br><small class="text-muted">${result.approvalLinks.client.email}</small>
                                    </div>
                                    <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Ready</span>
                                </div>
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-sm font-monospace" value="${result.approvalLinks.client.link}" readonly id="approvalLinkClient">
                                    <button class="btn btn-outline-primary btn-sm" onclick="copyToClipboard('approvalLinkClient')" title="Copy link">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="card mb-3">
                            <div class="card-body py-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-warning text-dark me-2 rounded-circle" style="width: 24px; height: 24px; line-height: 18px;">2</span>
                                    <div class="flex-grow-1">
                                        <strong>${result.approvalLinks.sponsor.name}</strong> <span class="badge bg-warning text-dark">Project Sponsor</span>
                                        <br><small class="text-muted">${result.approvalLinks.sponsor.email}</small>
                                    </div>
                                    <span class="badge bg-secondary"><i class="bi bi-clock me-1"></i>Waiting for #1</span>
                                </div>
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-sm font-monospace" value="${result.approvalLinks.sponsor.link}" readonly id="approvalLinkSponsor">
                                    <button class="btn btn-outline-primary btn-sm" onclick="copyToClipboard('approvalLinkSponsor')" title="Copy link">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                                <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i>Link will work after Client approves</small>
                            </div>
                        </div>
                        <div class="card mb-3">
                            <div class="card-body py-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-secondary me-2 rounded-circle" style="width: 24px; height: 24px; line-height: 18px;">3</span>
                                    <div class="flex-grow-1">
                                        <strong>${result.approvalLinks.executive.name}</strong> <span class="badge bg-secondary">Executive</span>
                                        <br><small class="text-muted">${result.approvalLinks.executive.email}</small>
                                    </div>
                                    <span class="badge bg-secondary"><i class="bi bi-clock me-1"></i>Waiting for #2</span>
                                </div>
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-sm font-monospace" value="${result.approvalLinks.executive.link}" readonly id="approvalLinkExec">
                                    <button class="btn btn-outline-primary btn-sm" onclick="copyToClipboard('approvalLinkExec')" title="Copy link">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                                <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i>Link will work after Sponsor approves</small>
                            </div>
                        </div>
                    `;
                } else {
                    alert('Error: ' + (result.error || 'Failed to generate approval links'));
                    this.disabled = false;
                    this.innerHTML = '<i class="bi bi-send me-1"></i> Generate Approval Links';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error generating approval links. Please try again.');
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-send me-1"></i> Generate Approval Links';
            }
        });
    }
});

// Copy to clipboard helper
function copyToClipboard(inputId) {
    const input = document.getElementById(inputId);
    input.select();
    document.execCommand('copy');
    
    // Visual feedback
    const btn = input.nextElementSibling;
    const originalHTML = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check-lg"></i>';
    btn.classList.remove('btn-outline-primary');
    btn.classList.add('btn-success');
    
    setTimeout(() => {
        btn.innerHTML = originalHTML;
        btn.classList.remove('btn-success');
        btn.classList.add('btn-outline-primary');
    }, 1500);
}
</script>
