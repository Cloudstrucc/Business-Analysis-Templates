{{!-- views/admin/user-validation-view.hbs --}}
{{!-- Admin view of client's validation responses --}}

<div class="container-fluid py-4">
    {{!-- Header --}}
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/admin/submissions">Submissions</a></li>
                    <li class="breadcrumb-item"><a href="/admin/submissions/{{submission.id}}">{{submission.clientName}}</a></li>
                    <li class="breadcrumb-item active">Client Validation</li>
                </ol>
            </nav>
            <h2 class="mb-1">
                <i class="bi bi-person-check me-2"></i>
                Client Validation Response
            </h2>
            <p class="text-muted mb-0">
                Review {{submission.clientName}}'s validation for {{submission.formName}}
            </p>
        </div>
        
        <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/submissions/{{submission.id}}/validation" class="btn btn-success">
                <i class="bi bi-check2-square me-1"></i> Admin Validation
            </a>
            <form action="/admin/submissions/{{submission.id}}/send-for-validation" method="POST" class="d-inline">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-arrow-repeat me-1"></i> Send Back for Re-validation
                </button>
            </form>
            <a href="/admin/submissions/{{submission.id}}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    {{!-- Summary Cards --}}
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-light text-center py-3">
                <h6 class="text-muted mb-1">Total Requirements</h6>
                <h3 class="mb-0" id="totalCount">0</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white text-center py-3">
                <h6 class="mb-1">Client Marked Met</h6>
                <h3 class="mb-0" id="metCount">0</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white text-center py-3">
                <h6 class="mb-1">Client Marked Not Met</h6>
                <h3 class="mb-0" id="notMetCount">0</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary text-white text-center py-3">
                <h6 class="mb-1">Not Validated</h6>
                <h3 class="mb-0" id="pendingCount">0</h3>
            </div>
        </div>
    </div>

    {{!-- Validation Data Table --}}
    <div class="card">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">
                <i class="bi bi-clipboard-data me-2"></i>
                Client's Validation Responses
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 25%;">Requirement</th>
                            <th style="width: 25%;">Original Response</th>
                            <th style="width: 15%;">Client Validation</th>
                            <th style="width: 30%;">Client Comments</th>
                        </tr>
                    </thead>
                    <tbody id="validationTableBody">
                        {{!-- Populated by JavaScript --}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
.validation-row.validated-yes {
    background-color: rgba(25, 135, 84, 0.1) !important;
}
.validation-row.validated-no {
    background-color: rgba(220, 53, 69, 0.1) !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const parsedData = {{{json parsedData}}};
    const userValidationData = {{{json userValidationData}}};
    
    const tbody = document.getElementById('validationTableBody');
    let rowNum = 0;
    let total = 0, met = 0, notMet = 0, pending = 0;
    
    for (const [key, value] of Object.entries(parsedData)) {
        if (key.startsWith('_') || key === 'metadata') continue;
        
        rowNum++;
        total++;
        
        const label = key
            .replace(/_/g, ' ')
            .replace(/([A-Z])/g, ' $1')
            .replace(/^./, str => str.toUpperCase())
            .trim();
        
        const fieldValidation = userValidationData[key] || {};
        const isMet = fieldValidation.met === 'yes';
        const isNotMet = fieldValidation.met === 'no';
        const comment = fieldValidation.comment || '';
        
        if (isMet) met++;
        else if (isNotMet) notMet++;
        else pending++;
        
        let displayValue = '';
        if (typeof value === 'boolean') {
            displayValue = value 
                ? '<span class="badge bg-success"><i class="bi bi-check-lg"></i> Yes</span>' 
                : '<span class="badge bg-danger"><i class="bi bi-x-lg"></i> No</span>';
        } else if (typeof value === 'object' && value !== null) {
            displayValue = '<pre class="mb-0 bg-light p-2 rounded small" style="white-space: pre-wrap; max-height: 100px; overflow-y: auto;">' + JSON.stringify(value, null, 2) + '</pre>';
        } else if (value) {
            displayValue = '<span class="text-break">' + String(value).substring(0, 150) + (String(value).length > 150 ? '...' : '') + '</span>';
        } else {
            displayValue = '<span class="text-muted fst-italic">No response</span>';
        }
        
        let statusBadge = '<span class="text-muted">-</span>';
        if (isMet) {
            statusBadge = '<span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Met</span>';
        } else if (isNotMet) {
            statusBadge = '<span class="badge bg-danger"><i class="bi bi-x-lg me-1"></i>Not Met</span>';
        }
        
        const row = document.createElement('tr');
        row.className = 'validation-row' + (isMet ? ' validated-yes' : '') + (isNotMet ? ' validated-no' : '');
        
        row.innerHTML = `
            <td class="text-muted">${rowNum}</td>
            <td><strong>${label}</strong></td>
            <td>${displayValue}</td>
            <td class="text-center">${statusBadge}</td>
            <td>${comment ? '<span class="small">' + comment + '</span>' : '<span class="text-muted fst-italic">No comment</span>'}</td>
        `;
        
        tbody.appendChild(row);
    }
    
    // Update counts
    document.getElementById('totalCount').textContent = total;
    document.getElementById('metCount').textContent = met;
    document.getElementById('notMetCount').textContent = notMet;
    document.getElementById('pendingCount').textContent = pending;
});
</script>
