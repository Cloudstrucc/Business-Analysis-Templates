{{!-- views/admin/approval-summary.hbs --}}
{{!-- Admin view to send met requirements for approval to multiple approvers --}}

<div class="container py-4">
    {{!-- Header --}}
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/admin/submissions">Submissions</a></li>
                    <li class="breadcrumb-item"><a href="/admin/submissions/{{submission.id}}">{{submission.clientName}}</a></li>
                    <li class="breadcrumb-item active">Approval Summary</li>
                </ol>
            </nav>
            <h2 class="mb-1">
                <i class="bi bi-clipboard-check me-2"></i>
                Approval Summary
            </h2>
            <p class="text-muted mb-0">
                {{submission.formName}} - {{submission.clientName}}
            </p>
        </div>
        
        <div class="d-flex gap-2 flex-wrap">
            {{#if projectClosed}}
            <button type="button" class="btn btn-warning" onclick="reopenProject()">
                <i class="bi bi-unlock me-1"></i> Re-open Project
            </button>
            {{/if}}
            <a href="/admin/submissions/{{submission.id}}/approval-summary/export-pdf" class="btn btn-primary">
                <i class="bi bi-file-pdf me-1"></i> Export PDF
            </a>
            <a href="/admin/submissions/{{submission.id}}/validation" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Validation
            </a>
        </div>
    </div>

    {{#if projectClosed}}
    <div class="alert alert-success mb-4">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-3 me-3"></i>
            <div>
                <strong>Project Closed</strong>
                <p class="mb-0">All approvers have approved. This project was closed on {{formatDate closedAt}}.</p>
            </div>
        </div>
    </div>
    {{/if}}

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Summary Stats -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-success text-white text-center py-3">
                        <h6 class="mb-1">Met Requirements</h6>
                        <h2 class="mb-0">{{stats.met}}</h2>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light text-center py-3">
                        <h6 class="text-muted mb-1">Total Requirements</h6>
                        <h2 class="mb-0">{{stats.total}}</h2>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white text-center py-3">
                        <h6 class="mb-1">Completion Rate</h6>
                        <h2 class="mb-0">{{stats.percentMet}}%</h2>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-primary text-white text-center py-3">
                        <h6 class="mb-1">Approvers</h6>
                        <h2 class="mb-0">{{approvers.length}}</h2>
                    </div>
                </div>
            </div>

            <!-- Met Requirements List -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-check-circle me-2"></i>
                        Met Requirements ({{metRequirements.length}})
                    </h5>
                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#metRequirementsList">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                <div class="collapse show" id="metRequirementsList">
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>Requirement</th>
                                        <th style="width: 150px;">Category</th>
                                        <th style="width: 200px;">Response</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each metRequirements}}
                                    <tr>
                                        <td class="text-muted">{{this.index}}</td>
                                        <td>
                                            <strong>{{this.label}}</strong>
                                            {{#if this.comment}}
                                            <br><small class="text-info"><i class="bi bi-chat-left-text me-1"></i>{{this.comment}}</small>
                                            {{/if}}
                                        </td>
                                        <td><span class="badge bg-secondary">{{this.category}}</span></td>
                                        <td>
                                            {{#if (eq this.responseType "yes")}}
                                            <span class="badge bg-success">Yes</span>
                                            {{else}}
                                            {{#if (eq this.responseType "no")}}
                                            <span class="badge bg-danger">No</span>
                                            {{else}}
                                            <small>{{this.responseDisplay}}</small>
                                            {{/if}}
                                            {{/if}}
                                        </td>
                                    </tr>
                                    {{else}}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">
                                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                            No requirements marked as Met yet.
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar - Approvers -->
        <div class="col-lg-4">
            <!-- Approval Status -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>
                        Approvers
                    </h5>
                </div>
                <div class="card-body">
                    {{#if approvers.length}}
                    <div class="approver-list">
                        {{#each approvers}}
                        <div class="approver-item d-flex justify-content-between align-items-start p-2 border rounded mb-2 {{#if this.approved_at}}bg-success-subtle{{else}}{{#if this.returned_at}}bg-danger-subtle{{else}}bg-light{{/if}}{{/if}}">
                            <div class="flex-grow-1">
                                <strong>{{this.name}}</strong>
                                <br>
                                <small class="text-muted">{{this.email}}</small>
                                {{#if this.approved_at}}
                                <br><span class="badge bg-success mt-1"><i class="bi bi-check me-1"></i>Approved {{formatDate this.approved_at}}</span>
                                {{else}}
                                {{#if this.returned_at}}
                                <br><span class="badge bg-danger mt-1"><i class="bi bi-arrow-return-left me-1"></i>Returned</span>
                                <br><small class="text-danger">{{this.return_reason}}</small>
                                {{else}}
                                <br><span class="badge bg-warning text-dark mt-1"><i class="bi bi-clock me-1"></i>Pending</span>
                                {{/if}}
                                {{/if}}
                            </div>
                            {{#unless ../projectClosed}}
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="copyApproverLink('{{this.token}}')">
                                            <i class="bi bi-clipboard me-2"></i>Copy Link
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="resendApprovalEmail('{{this.id}}')">
                                            <i class="bi bi-envelope me-2"></i>Resend Email
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="#" onclick="removeApprover('{{this.id}}')">
                                            <i class="bi bi-trash me-2"></i>Remove
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            {{/unless}}
                        </div>
                        {{/each}}
                    </div>
                    {{else}}
                    <p class="text-muted text-center mb-0">
                        <i class="bi bi-person-plus d-block fs-2 mb-2"></i>
                        No approvers added yet.
                    </p>
                    {{/if}}
                </div>
                {{#unless projectClosed}}
                <div class="card-footer">
                    <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#addApproverModal">
                        <i class="bi bi-person-plus me-1"></i> Add Approver
                    </button>
                </div>
                {{/unless}}
            </div>

            <!-- Quick Actions -->
            {{#unless projectClosed}}
            <div class="card mb-4">
                <div class="card-header">
                    <strong><i class="bi bi-lightning me-2"></i>Quick Actions</strong>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-success" onclick="sendAllApprovalRequests()" {{#unless approvers.length}}disabled{{/unless}}>
                            <i class="bi bi-send me-1"></i> Send All Approval Requests
                        </button>
                        <button type="button" class="btn btn-outline-info" onclick="previewApproverView()">
                            <i class="bi bi-eye me-1"></i> Preview Approver View
                        </button>
                    </div>
                </div>
            </div>
            {{/unless}}

            <!-- Approval History -->
            <div class="card">
                <div class="card-header">
                    <strong><i class="bi bi-clock-history me-2"></i>History</strong>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                        {{#each auditLog}}
                        <div class="list-group-item py-2">
                            <div class="d-flex justify-content-between">
                                <small class="fw-bold">{{this.action}}</small>
                                <small class="text-muted">{{this.created_at}}</small>
                            </div>
                            <small class="text-muted">{{this.actor}}</small>
                        </div>
                        {{else}}
                        <div class="list-group-item text-center text-muted py-3">
                            No history yet.
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Approver Modal -->
<div class="modal fade" id="addApproverModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Add Approver</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addApproverForm">
                    <div class="mb-3">
                        <label class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="approverName" required placeholder="e.g., John Smith">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="approverEmail" required placeholder="e.g., john@company.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role/Title (optional)</label>
                        <input type="text" class="form-control" id="approverRole" placeholder="e.g., Project Sponsor">
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="sendEmailNow" checked>
                        <label class="form-check-label" for="sendEmailNow">Send approval request email immediately</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="addApprover()">
                    <i class="bi bi-plus-lg me-1"></i> Add Approver
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.approver-item {
    transition: all 0.2s;
}
.approver-item:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
.bg-success-subtle {
    background-color: rgba(25, 135, 84, 0.1) !important;
}
.bg-danger-subtle {
    background-color: rgba(220, 53, 69, 0.1) !important;
}
</style>

<script>
const submissionId = '{{submission.id}}';
const baseUrl = '{{baseUrl}}';

async function addApprover() {
    const name = document.getElementById('approverName').value.trim();
    const email = document.getElementById('approverEmail').value.trim();
    const role = document.getElementById('approverRole').value.trim();
    const sendEmail = document.getElementById('sendEmailNow').checked;
    
    if (!name || !email) {
        alert('Please fill in name and email');
        return;
    }
    
    try {
        const response = await fetch(`/admin/submissions/${submissionId}/approvers`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, role, sendEmail })
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert(`Approver added${sendEmail ? ' and email sent' : ''}!`);
            location.reload();
        } else {
            alert('Error: ' + (result.error || 'Unknown error'));
        }
    } catch (error) {
        console.error(error);
        alert('Error adding approver');
    }
}

async function removeApprover(approverId) {
    if (!confirm('Remove this approver?')) return;
    
    try {
        const response = await fetch(`/admin/submissions/${submissionId}/approvers/${approverId}`, {
            method: 'DELETE'
        });
        
        const result = await response.json();
        
        if (result.success) {
            location.reload();
        } else {
            alert('Error: ' + (result.error || 'Unknown error'));
        }
    } catch (error) {
        console.error(error);
        alert('Error removing approver');
    }
}

async function resendApprovalEmail(approverId) {
    try {
        const response = await fetch(`/admin/submissions/${submissionId}/approvers/${approverId}/resend`, {
            method: 'POST'
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert('Approval request email sent!');
        } else {
            alert('Error: ' + (result.error || 'Unknown error'));
        }
    } catch (error) {
        console.error(error);
        alert('Error sending email');
    }
}

async function sendAllApprovalRequests() {
    if (!confirm('Send approval request emails to all pending approvers?')) return;
    
    try {
        const response = await fetch(`/admin/submissions/${submissionId}/approvers/send-all`, {
            method: 'POST'
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert(`Sent ${result.count} approval request(s)!`);
            location.reload();
        } else {
            alert('Error: ' + (result.error || 'Unknown error'));
        }
    } catch (error) {
        console.error(error);
        alert('Error sending emails');
    }
}

function copyApproverLink(token) {
    const url = `${baseUrl}/approve/${token}`;
    navigator.clipboard.writeText(url).then(() => {
        alert('Approval link copied to clipboard!');
    });
}

function previewApproverView() {
    {{#if approvers.length}}
    window.open(`${baseUrl}/approve/{{approvers.[0].token}}?preview=1`, '_blank');
    {{else}}
    alert('Add an approver first to preview the approver view.');
    {{/if}}
}

async function reopenProject() {
    if (!confirm('Re-open this project? This will allow further edits and require new approvals.')) return;
    
    try {
        const response = await fetch(`/admin/submissions/${submissionId}/reopen`, {
            method: 'POST'
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert('Project re-opened!');
            location.reload();
        } else {
            alert('Error: ' + (result.error || 'Unknown error'));
        }
    } catch (error) {
        console.error(error);
        alert('Error re-opening project');
    }
}
</script>
