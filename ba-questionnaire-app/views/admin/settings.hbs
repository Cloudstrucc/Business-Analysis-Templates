{{!-- views/admin/settings.hbs --}}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Settings</h1>
            <p class="text-muted mb-0">Application configuration</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            {{!-- Email Configuration --}}
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-envelope me-2"></i>
                        Email Configuration
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Email settings are configured via environment variables. Update your <code>.env</code> file to change these settings.
                    </p>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">SMTP Host</label>
                            <input type="text" class="form-control" value="{{settings.smtpHost}}" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">SMTP Port</label>
                            <input type="text" class="form-control" value="{{settings.smtpPort}}" readonly>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted">From Address</label>
                            <input type="text" class="form-control" value="{{settings.smtpFrom}}" readonly placeholder="Not configured">
                        </div>
                    </div>
                    
                    <div class="alert alert-info mt-3 mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>To configure email:</strong> Set <code>SMTP_USER</code>, <code>SMTP_PASS</code>, and <code>SMTP_FROM</code> in your environment variables.
                    </div>
                </div>
            </div>

            {{!-- Application Settings --}}
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-gear me-2"></i>
                        Application Settings
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Admin Email</label>
                            <input type="text" class="form-control" value="{{settings.adminEmail}}" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Base URL</label>
                            <input type="text" class="form-control" value="{{settings.baseUrl}}" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Analytics Digest Interval</label>
                            <input type="text" class="form-control" value="{{settings.analyticsInterval}} hours" readonly>
                        </div>
                    </div>
                </div>
            </div>

            {{!-- Environment Variables Reference --}}
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-code-slash me-2"></i>
                        Environment Variables Reference
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Configure these in your <code>.env</code> file:</p>
                    
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Variable</th>
                                    <th>Description</th>
                                    <th>Example</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>ADMIN_EMAIL</code></td>
                                    <td>Admin login email</td>
                                    <td>admin@yourcompany.com</td>
                                </tr>
                                <tr>
                                    <td><code>ADMIN_PASSWORD</code></td>
                                    <td>Admin login password</td>
                                    <td>your-secure-password</td>
                                </tr>
                                <tr>
                                    <td><code>SMTP_HOST</code></td>
                                    <td>SMTP server hostname</td>
                                    <td>smtp.office365.com</td>
                                </tr>
                                <tr>
                                    <td><code>SMTP_PORT</code></td>
                                    <td>SMTP server port</td>
                                    <td>587</td>
                                </tr>
                                <tr>
                                    <td><code>SMTP_USER</code></td>
                                    <td>SMTP authentication user</td>
                                    <td>user@yourcompany.com</td>
                                </tr>
                                <tr>
                                    <td><code>SMTP_PASS</code></td>
                                    <td>SMTP authentication password</td>
                                    <td>your-smtp-password</td>
                                </tr>
                                <tr>
                                    <td><code>SMTP_FROM</code></td>
                                    <td>From email address</td>
                                    <td>forms@yourcompany.com</td>
                                </tr>
                                <tr>
                                    <td><code>BASE_URL</code></td>
                                    <td>Public URL of the application</td>
                                    <td>https://forms.yourcompany.com</td>
                                </tr>
                                <tr>
                                    <td><code>SESSION_SECRET</code></td>
                                    <td>Session encryption key</td>
                                    <td>random-32-char-string</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            {{!-- Quick Actions --}}
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="bi bi-lightning me-2"></i>
                        Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <form action="/admin/forms/reload" method="POST">
                            <button type="submit" class="btn btn-outline-primary w-100">
                                <i class="bi bi-arrow-clockwise me-2"></i>
                                Reload Form Templates
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            {{!-- System Info --}}
            <div class="card">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        System Info
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <small class="text-muted">Node.js Version</small>
                            <br><strong>{{nodeVersion}}</strong>
                        </li>
                        <li class="mb-2">
                            <small class="text-muted">Environment</small>
                            <br><strong>{{env}}</strong>
                        </li>
                        <li>
                            <small class="text-muted">Application</small>
                            <br><strong>Cloudstrucc BA Forms v1.0.0</strong>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
