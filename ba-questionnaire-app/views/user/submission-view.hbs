{{!-- views/user/submission-view.hbs --}}
{{!-- User-facing submission view with validation workflow --}}

<div class="container py-4">
    {{!-- Header --}}
    <div class="row justify-content-center mb-4">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h2 class="mb-1">
                        <i class="bi bi-file-earmark-text me-2"></i>
                        {{submission.formName}}
                    </h2>
                    <p class="text-muted mb-0">
                        Submitted by {{submission.clientName}} 
                        {{#if submission.companyName}}- {{submission.companyName}}{{/if}}
                    </p>
                </div>
                
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/validate/submission/{{invite.code}}/{{submission.id}}/export-pdf" class="btn btn-primary">
                        <i class="bi bi-file-pdf me-1"></i> Export PDF
                    </a>
                    {{#if canValidate}}
                    <a href="/validate/submission/{{invite.code}}/{{submission.id}}/validate" class="btn btn-success">
                        <i class="bi bi-check2-square me-1"></i> Validate Requirements
                    </a>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            {{!-- Status Banner --}}
            {{#if canValidate}}
            <div class="alert alert-warning mb-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle fs-4 me-3"></i>
                    <div class="flex-grow-1">
                        <h5 class="mb-1">Validation Required</h5>
                        <p class="mb-0">Please review your submission and validate each requirement. Click the "Validate Requirements" button to proceed.</p>
                    </div>
                    <a href="/validate/submission/{{invite.code}}/{{submission.id}}/validate" class="btn btn-warning ms-3">
                        <i class="bi bi-check2-square me-1"></i> Validate Now
                    </a>
                </div>
            </div>
            {{/if}}
            
            {{#if isReadOnly}}
            <div class="alert alert-info mb-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-lock fs-4 me-3"></i>
                    <div>
                        <h5 class="mb-1">Validation Submitted</h5>
                        <p class="mb-0">Your validation has been submitted and is being reviewed. This submission is now in read-only mode.</p>
                    </div>
                </div>
            </div>
            {{/if}}

            {{!-- Submission Info Card --}}
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Submission Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <th class="text-muted ps-0" style="width: 40%;">Client Name:</th>
                                    <td>{{submission.clientName}}</td>
                                </tr>
                                <tr>
                                    <th class="text-muted ps-0">Company:</th>
                                    <td>{{submission.companyName}}</td>
                                </tr>
                                <tr>
                                    <th class="text-muted ps-0">Email:</th>
                                    <td>{{submission.clientEmail}}</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <th class="text-muted ps-0" style="width: 40%;">Form:</th>
                                    <td>{{submission.formName}}</td>
                                </tr>
                                <tr>
                                    <th class="text-muted ps-0">Status:</th>
                                    <td>
                                        {{#eq submission.status 'submitted'}}
                                        <span class="badge bg-success">Submitted</span>
                                        {{else}}
                                        <span class="badge bg-warning">In Progress</span>
                                        {{/eq}}
                                        
                                        {{#eq validationStatus 'pending_user_validation'}}
                                        <span class="badge bg-warning ms-1">Awaiting Validation</span>
                                        {{/eq}}
                                        {{#eq validationStatus 'user_submitted'}}
                                        <span class="badge bg-info ms-1">Validation Submitted</span>
                                        {{/eq}}
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-muted ps-0">Submitted:</th>
                                    <td>{{formatDate submission.submitted_at}}</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            {{!-- Responses Card --}}
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-list-check me-2"></i>
                        Your Responses
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="responsesTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%;">#</th>
                                    <th style="width: 40%;">Question / Requirement</th>
                                    <th style="width: 40%;">Your Response</th>
                                    {{#if isReadOnly}}
                                    <th style="width: 15%;">Your Validation</th>
                                    {{/if}}
                                </tr>
                            </thead>
                            <tbody id="responsesTableBody">
                                {{!-- Populated by JavaScript --}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {{!-- Attachments Card --}}
            {{#if attachments.length}}
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-paperclip me-2"></i>
                        Attachments
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        {{#each attachments}}
                        <a href="{{this.fileUrl}}" target="_blank" rel="noopener noreferrer" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-link-45deg me-2"></i>
                                {{this.fileName}}
                                {{#if this.description}}
                                <br><small class="text-muted">{{this.description}}</small>
                                {{/if}}
                            </div>
                            <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                        {{/each}}
                    </div>
                </div>
            </div>
            {{/if}}

            {{!-- Action Buttons --}}
            <div class="d-flex justify-content-between align-items-center">
                <a href="/form/{{invite.code}}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Forms
                </a>
                
                <div class="d-flex gap-2">
                    <a href="/validate/submission/{{invite.code}}/{{submission.id}}/export-pdf" class="btn btn-primary">
                        <i class="bi bi-file-pdf me-1"></i> Export PDF
                    </a>
                    {{#if canValidate}}
                    <a href="/validate/submission/{{invite.code}}/{{submission.id}}/validate" class="btn btn-success">
                        <i class="bi bi-check2-square me-1"></i> Validate Requirements
                    </a>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const parsedData = {{{json parsedData}}};
    const userValidationData = {{{json userValidationData}}};
    const isReadOnly = {{#if isReadOnly}}true{{else}}false{{/if}};
    
    const tbody = document.getElementById('responsesTableBody');
    let rowNum = 0;
    
    for (const [key, value] of Object.entries(parsedData)) {
        if (key.startsWith('_') || key === 'metadata') continue;
        
        rowNum++;
        
        const label = key
            .replace(/_/g, ' ')
            .replace(/([A-Z])/g, ' $1')
            .replace(/^./, str => str.toUpperCase())
            .trim();
        
        let displayValue = '';
        if (typeof value === 'boolean') {
            displayValue = value 
                ? '<span class="badge bg-success"><i class="bi bi-check-lg"></i> Yes</span>' 
                : '<span class="badge bg-danger"><i class="bi bi-x-lg"></i> No</span>';
        } else if (typeof value === 'object' && value !== null) {
            displayValue = '<pre class="mb-0 bg-light p-2 rounded small" style="white-space: pre-wrap;">' + JSON.stringify(value, null, 2) + '</pre>';
        } else if (value) {
            displayValue = '<span class="text-break">' + String(value) + '</span>';
        } else {
            displayValue = '<span class="text-muted fst-italic">No response</span>';
        }
        
        // Get user validation for this field
        const fieldValidation = userValidationData[key] || {};
        let validationBadge = '';
        if (isReadOnly && fieldValidation.met) {
            if (fieldValidation.met === 'yes') {
                validationBadge = '<span class="badge bg-success"><i class="bi bi-check-lg"></i> Met</span>';
            } else if (fieldValidation.met === 'no') {
                validationBadge = '<span class="badge bg-danger"><i class="bi bi-x-lg"></i> Not Met</span>';
            }
            if (fieldValidation.comment) {
                validationBadge += '<br><small class="text-muted">' + fieldValidation.comment + '</small>';
            }
        }
        
        const row = document.createElement('tr');
        row.innerHTML = `
            <td class="text-muted">${rowNum}</td>
            <td><strong>${label}</strong></td>
            <td>${displayValue}</td>
            ${isReadOnly ? `<td>${validationBadge || '<span class="text-muted">-</span>'}</td>` : ''}
        `;
        tbody.appendChild(row);
    }
});
</script>
